9067 struct cmd*
9068 parsecmd(char *s)
9069 {
9070   char *es;
9071   struct cmd *cmd;
9072 
9073   es = s + strlen(s);
9074   cmd = parseline(&s, es);
9075   peek(&s, es, "");
9076   if(s != es){
9077     printf(2, "leftovers: %s\n", s);
9078     panic("syntax");
9079   }
9080   nulterminate(cmd);
9081   return cmd;
9082 }

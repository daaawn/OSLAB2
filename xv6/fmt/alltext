9150 struct cmd*
9151 parseblock(char **ps, char *es)
9152 {
9153   struct cmd *cmd;
9154 
9155   if(!peek(ps, es, "("))
9156     panic("parseblock");
9157   gettoken(ps, es, 0, 0);
9158   cmd = parseline(ps, es);
9159   if(!peek(ps, es, ")"))
9160     panic("syntax - missing )");
9161   gettoken(ps, es, 0, 0);
9162   cmd = parseredirs(cmd, ps, es);
9163   return cmd;
9164 }

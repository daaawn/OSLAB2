8788     break;
8789 
8790   case LIST:
8791     lcmd = (struct listcmd*)cmd;
8792     if(fork1() == 0)
8793       runcmd(lcmd->left);
8794     wait();
8795     runcmd(lcmd->right);
8796     break;
8797 

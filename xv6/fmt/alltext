6910 void
6911 pipeclose(struct pipe *p, int writable)
6912 {
6913   acquire(&p->lock);
6914   if(writable){
6915     p->writeopen = 0;
6916     wakeup(&p->nread);
6917   } else {
6918     p->readopen = 0;
6919     wakeup(&p->nwrite);
6920   }
6921   if(p->readopen == 0 && p->writeopen == 0){
6922     release(&p->lock);
6923     kfree((char*)p);
6924   } else
6925     release(&p->lock);
6926 }

8800   case PIPE:
8801     pcmd = (struct pipecmd*)cmd;
8802     if(pipe(p) < 0)
8803       panic("pipe");
8804     if(fork1() == 0){
8805       close(1);
8806       dup(p[1]);
8807       close(p[0]);
8808       close(p[1]);
8809       runcmd(pcmd->left);
8810     }
8811     if(fork1() == 0){
8812       close(0);
8813       dup(p[0]);
8814       close(p[0]);
8815       close(p[1]);
8816       runcmd(pcmd->right);
8817     }
8818     close(p[0]);
8819     close(p[1]);
8820     wait();
8821     wait();
8822     break;
8823 
8824   case BACK:
8825     bcmd = (struct backcmd*)cmd;
8826     if(fork1() == 0)
8827       runcmd(bcmd->cmd);
8828     break;
8829   }
8830   exit();
